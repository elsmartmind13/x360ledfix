<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1B1B24"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="X360 LED Fix"
            android:textColor="#FF7CFC4F"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="Проверяю ресивер…"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/autoRepeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="Повторять команду каждые 10 секунд"
            android:textColor="#FFE8E8F0"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnOff"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Погасить индикаторы"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnP1"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="Игрок 1"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnP2"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Игрок 2"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnP3"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Игрок 3"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnP4"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="Игрок 4"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/btnBlink"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Мигать (тест)"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnRotate"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="Бегущий огонёк"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Приложение отправляет геймпаду Xbox 360 команду Set LED (пакет 01 00 08 4X через ресивер), которую прошивка телевизора не отправляет — из-за этого все четыре индикатора мигают. После команды индикатор перестаёт мигать до отключения геймпада.\n\nЕсли статус показывает «интерфейс занят» — вытащите ресивер и вставьте обратно, затем нажмите кнопку сразу после появления статуса «Ресивер подключён»."
            android:textColor="#FFB0B0C0"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
